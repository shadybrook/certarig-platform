DRV8871 steady conduction / thermal analogy: drv8871_1.5A_hot_board_bound
Vbus bus 0 12
Rbridge bus load 0.96
Iload load 0 1.5
Bheat 0 trise I=i(Vbus)*i(Vbus)*0.96
Rtheta trise 0 65
Cthermal trise 0 .02 IC=0
Bjunction tj 0 V=50+v(trise)

.options method=gear reltol=1e-5
.control
set wr_singlescale
set wr_vecnames
set numdgt=12
tran 0.01 15 0 0.01
wrdata trace.dat v(load) v(tj) i(Vbus)
quit
.endc
.end
