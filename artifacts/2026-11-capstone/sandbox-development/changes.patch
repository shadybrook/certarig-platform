+
+    def export_sandbox(self, sandbox_id: str) -> bytes:
+        data: bytes = self.request("GET", f"/v1/sandboxes/{sandbox_id}/export", raw=True)
+        return data
+
+    def close_sandbox(self, sandbox_id: str) -> dict[str, Any]:
