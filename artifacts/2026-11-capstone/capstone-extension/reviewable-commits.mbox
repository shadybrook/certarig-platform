+)
+def test_interview_refusals(node_factory, bad):
+    node, op, agent = node_factory()
+    iv = op.post("/v1/commissioning/interviews", {})
+    base = "/v1/commissioning/interviews/" + iv["interview_id"]
+    answers = complete_answers(raw_config())
