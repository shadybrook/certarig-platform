+        pass
+
+    def loop_start(self):
+        pass
+
+    def subscribe(self, *args, **kwargs):
+        pass
+
+    def disconnect(self):
+        pass
+
+    def loop_stop(self):
+        pass
+
+    def username_pw_set(self, *args):
+        pass
+
+    def tls_set(self):
+        pass
+
