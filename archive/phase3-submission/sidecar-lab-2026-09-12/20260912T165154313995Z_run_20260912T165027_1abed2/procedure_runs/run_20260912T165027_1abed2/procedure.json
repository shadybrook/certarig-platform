{
  "applies_to": {
    "actuators": [
      "permit_relay"
    ],
    "concepts": [
      "pressure",
      "flow",
      "emergency_stop"
    ]
  },
  "domain": "process",
  "evaluate": [
    {
      "event_observed": "permit_accepted"
    },
    {
      "event_observed": "pressure_high_forced_safe"
    },
    {
      "event_observed": "flow_high_forced_safe"
    },
    {
      "event_observed": "permit_rejected_reset_required"
    },
    {
      "max_elapsed_ms": 500,
      "step": "pressure_output_removed"
    },
    {
      "max_elapsed_ms": 500,
      "step": "flow_output_removed"
    },
    {
      "step_passed": "no_auto_restart"
    },
    {
      "peak_below": 9.5,
      "signal": "pressure"
    },
    {
      "peak_below": 19.5,
      "signal": "flow"
    }
  ],
  "evidence": {
    "flight_recorder_s": 30,
    "report_template": "qualification_report"
  },
  "id": "dual_pot_guardrail",
  "preconditions": [
    {
      "op": "<",
      "signal": "pressure",
      "value": 4.0
    },
    {
      "op": "<",
      "signal": "flow",
      "value": 14.0
    },
    {
      "eq": "safe",
      "signal_state": "pressure"
    },
    {
      "eq": "safe",
      "signal_state": "flow"
    },
    {
      "eq": "good",
      "quality": "pressure"
    },
    {
      "eq": "good",
      "quality": "flow"
    },
    {
      "eq": false,
      "state": "estop_active"
    }
  ],
  "record": true,
  "recovery": "If either pot fails to drop the output, stop: force safe, remove the external 5 V supply and inspect GPIO23 and the ADS1115 wiring for that channel before retrying.\n",
  "requires_output": true,
  "steps": [
    {
      "command": "safe",
      "expect": {
        "eq": false,
        "state": "output_high"
      },
      "id": "safe_start",
      "type": "command"
    },
    {
      "command": "reset",
      "expect": {
        "eq": false,
        "state": "trip_latched"
      },
      "id": "reset",
      "type": "command"
    },
    {
      "command": "permit",
      "expect": {
        "all": [
          {
            "eq": true,
            "state": "drive_high"
          },
          {
            "eq": true,
            "state": "output_high"
          }
        ]
      },
      "id": "permit",
      "type": "command",
      "within_ms": 500
    },
    {
      "hold_ms": 1000,
      "id": "stable_permit",
      "predicate": {
        "eq": true,
        "state": "output_high"
      },
      "type": "expect",
      "within_ms": 500
    },
    {
      "id": "raise_pressure",
      "instruction": "Turn P1 up slowly until the dashboard shows more than 4.2 bar. Leave P2 in the safe band. Do not touch the E-stop.\n",
      "predicate": {
        "op": ">",
        "signal": "pressure",
        "value": 4.2
      },
      "timeout_s": 300,
      "title": "Operator raises pressure above the trip limit",
      "type": "trigger"
    },
    {
      "id": "pressure_output_removed",
      "predicate": {
        "all": [
          {
            "eq": false,
            "state": "output_high"
          },
          {
            "eq": true,
            "state": "trip_latched"
          }
        ]
      },
      "type": "expect",
      "within_ms": 500
    },
    {
      "id": "lower_pressure",
      "instruction": "Turn P1 back down below 3.5 bar. Leave P2 untouched.",
      "predicate": {
        "op": "<",
        "signal": "pressure",
        "value": 3.5
      },
      "timeout_s": 300,
      "title": "Operator returns pressure to the safe band",
      "type": "trigger"
    },
    {
      "command": "reset",
      "expect": {
        "eq": false,
        "state": "trip_latched"
      },
      "id": "reset_after_pressure",
      "type": "command"
    },
    {
      "command": "permit",
      "expect": {
        "all": [
          {
            "eq": true,
            "state": "drive_high"
          },
          {
            "eq": true,
            "state": "output_high"
          }
        ]
      },
      "id": "permit_after_pressure",
      "type": "command",
      "within_ms": 500
    },
    {
      "id": "raise_flow",
      "instruction": "Turn P2 up slowly until the dashboard shows more than 15.0 L/min. Leave P1 in the safe band.\n",
      "predicate": {
        "op": ">",
        "signal": "flow",
        "value": 15.0
      },
      "timeout_s": 300,
      "title": "Operator raises flow above the trip limit",
      "type": "trigger"
    },
    {
      "id": "flow_output_removed",
      "predicate": {
        "all": [
          {
            "eq": false,
            "state": "output_high"
          },
          {
            "eq": true,
            "state": "trip_latched"
          }
        ]
      },
      "type": "expect",
      "within_ms": 500
    },
    {
      "id": "lower_flow",
      "instruction": "Turn P2 back down below 10 L/min.",
      "predicate": {
        "op": "<",
        "signal": "flow",
        "value": 10.0
      },
      "timeout_s": 300,
      "title": "Operator returns flow to the safe band",
      "type": "trigger"
    },
    {
      "hold_ms": 1500,
      "id": "no_auto_restart",
      "predicate": {
        "all": [
          {
            "eq": false,
            "state": "output_high"
          },
          {
            "eq": "reset_required",
            "state": "reason"
          }
        ]
      },
      "type": "expect",
      "within_ms": 1000
    },
    {
      "command": "permit",
      "expect": {
        "all": [
          {
            "eq": false,
            "state": "output_high"
          },
          {
            "eq": "permit_rejected_reset_required",
            "state": "last_event"
          }
        ]
      },
      "id": "permit_rejected",
      "type": "command"
    },
    {
      "command": "safe",
      "expect": {
        "eq": false,
        "state": "output_high"
      },
      "id": "end_safe",
      "type": "command"
    }
  ],
  "summary": "Permits once, proves P1 (pressure) forces safe, resets and permits again, then proves P2 (flow) forces safe independently. Shows the two emulators are not one aliased channel.\n",
  "tags": [
    "interlock",
    "pressure",
    "flow",
    "trip",
    "anti-restart"
  ],
  "timeout_s": 900,
  "title": "Dual potentiometer guardrail",
  "version": 1
}