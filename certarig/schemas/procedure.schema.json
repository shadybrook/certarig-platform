{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://certarig.dev/schemas/procedure.schema.json",
  "title": "CertaRig procedure",
  "description": "A deterministic test procedure. The runtime executes steps in order; predicates use a closed grammar evaluated by pure functions. The LLM never evaluates a predicate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "maxLength": 1000
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 32
      },
      "maxItems": 16
    },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concepts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "actuators": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "hardware_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mock",
              "simulator",
              "raspberry_pi"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "requires_output": {
      "type": "boolean",
      "default": false,
      "description": "True when the procedure energises the permit output; refused on monitor-only nodes."
    },
    "record": {
      "type": "boolean",
      "default": true,
      "description": "Start a CSV recording for the whole run."
    },
    "timeout_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 7200,
      "default": 600
    },
    "preconditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/predicate"
      },
      "maxItems": 32
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "evaluate": {
      "type": "array",
      "description": "Pass/fail checks over the run record, evaluated after the last step.",
      "items": {
        "$ref": "#/$defs/check"
      },
      "maxItems": 32
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "report_template": {
          "type": "string",
          "maxLength": 120
        },
        "flight_recorder_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 120
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "recovery": {
      "type": "string",
      "maxLength": 2000,
      "description": "Operator-facing recovery guidance shown when the run fails or aborts."
    }
  },
  "$defs": {
    "number": {
      "type": "number"
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "signal",
            "op",
            "value"
          ],
          "properties": {
            "signal": {
              "type": "string",
              "description": "Concept (pressure) or channel_id."
            },
            "op": {
              "type": "string",
              "enum": [
                "<",
                "<=",
                ">",
                ">=",
                "==",
                "!="
              ]
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "signal_state",
            "eq"
          ],
          "properties": {
            "signal_state": {
              "type": "string"
            },
            "eq": {
              "type": "string",
              "enum": [
                "safe",
                "low",
                "high",
                "invalid",
                "missing"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quality",
            "eq"
          ],
          "properties": {
            "quality": {
              "type": "string"
            },
            "eq": {
              "type": "string",
              "enum": [
                "good",
                "bad",
                "missing"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "eq"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "estop_active",
                "trip_latched",
                "permit_requested",
                "drive_high",
                "process_healthy",
                "output_high",
                "relay_energized_expected",
                "recording_active",
                "reason",
                "last_event",
                "status"
              ]
            },
            "eq": {
              "type": [
                "boolean",
                "string"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/predicate"
            }
          }
        }
      ]
    },
    "step_base": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "allow_estop": {
          "type": "boolean",
          "default": false,
          "description": "Do not abort the run when the E-stop becomes active during this step (the step is testing it)."
        },
        "allow_invalid_sensor": {
          "type": "boolean",
          "default": false,
          "description": "Do not fail the step when a required signal becomes invalid (the step is testing sensor faults)."
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/step_base"
            },
            {
              "properties": {
                "type": {
                  "const": "command"
                },
                "command": {
                  "type": "string",
                  "enum": [
                    "safe",
                    "reset",
                    "permit"
                  ]
                },
                "expect": {
                  "$ref": "#/$defs/predicate"
                },
                "within_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 60000,
                  "default": 1000
                }
              },
              "required": [
                "command"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/step_base"
            },
            {
              "properties": {
                "type": {
                  "const": "expect"
                },
                "predicate": {
                  "$ref": "#/$defs/predicate"
                },
                "within_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 600000,
                  "default": 1000
                },
                "hold_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 600000,
                  "default": 0,
                  "description": "Once true, the predicate must stay true for this long."
                }
              },
              "required": [
                "predicate"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/step_base"
            },
            {
              "properties": {
                "type": {
                  "const": "trigger"
                },
                "predicate": {
                  "$ref": "#/$defs/predicate"
                },
                "timeout_s": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 3600,
                  "default": 300
                },
                "instruction": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "predicate"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/step_base"
            },
            {
              "properties": {
                "type": {
                  "const": "await_operator"
                },
                "instruction": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 500
                },
                "timeout_s": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 3600,
                  "default": 600
                },
                "confirm": {
                  "$ref": "#/$defs/predicate",
                  "description": "Optional predicate that must hold when the operator acknowledges."
                }
              },
              "required": [
                "instruction"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/step_base"
            },
            {
              "properties": {
                "type": {
                  "const": "wait"
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 600000
                }
              },
              "required": [
                "duration_ms"
              ]
            }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/step_base"
            },
            {
              "properties": {
                "type": {
                  "const": "record"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "start",
                    "stop",
                    "mark"
                  ]
                },
                "label": {
                  "type": "string",
                  "maxLength": 40
                }
              },
              "required": [
                "action"
              ]
            }
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "check": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_observed"
          ],
          "properties": {
            "event_observed": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_not_observed"
          ],
          "properties": {
            "event_not_observed": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step_passed"
          ],
          "properties": {
            "step_passed": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step",
            "max_elapsed_ms"
          ],
          "properties": {
            "step": {
              "type": "string"
            },
            "max_elapsed_ms": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "signal",
            "peak_below"
          ],
          "properties": {
            "signal": {
              "type": "string"
            },
            "peak_below": {
              "type": "number"
            }
          }
        }
      ]
    }
  }
}
