{
  "revision": "workbench-authoring/2",
  "authority": "draft_and_analysis_only",
  "tools": [
    {
      "name": "create_agent_draft",
      "description": "Create an inert commissioning draft.",
      "method": "POST",
      "path": [
        "drafts"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "template": {
            "enum": [
              "commissioning",
              "analysis",
              "revalidation",
              "evidence",
              "reporting"
            ]
          },
          "base_version_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "asset_id",
          "goal"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "read_agent_draft",
      "description": "Inspect a scoped draft and blockers.",
      "method": "GET",
      "path": [
        "drafts",
        ":draft_id"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "draft_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "draft_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "add_draft_requirement",
      "description": "Append a requirement with revision checking.",
      "method": "POST",
      "path": [
        "drafts",
        ":draft_id"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "draft_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "draft_id",
          "expected_revision",
          "message"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "submit_agent_evaluation",
      "description": "Queue an authored version for evaluation.",
      "method": "POST",
      "path": [
        "tasks"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "evaluate",
              "team_evaluate"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "kind",
          "target_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "read_task",
      "description": "Read scoped task progress.",
      "method": "GET",
      "path": [
        "tasks",
        ":task_id"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "task_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "read_evidence_index",
      "description": "List permitted evidence.",
      "method": "GET",
      "path": [
        "evidence"
      ],
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "run_reviewed_analysis",
      "description": "Run a reviewed Sandbox analysis tool.",
      "method": "POST",
      "path": [
        "tools",
        ":tool_id",
        "run"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "tool_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "inputs": {
            "type": "object"
          }
        },
        "required": [
          "tool_id",
          "inputs"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "read_analysis",
      "description": "Inspect scoped analysis status.",
      "method": "GET",
      "path": [
        "analyses",
        ":analysis_id"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "analysis_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "analysis_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "draft_bench_description",
      "description": "Create an inert operator-declared bench description. Does not map equipment or qualify a procedure.",
      "method": "POST",
      "path": [
        "bench-specs"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "facts": {
            "title": "Operator-declared bench description, never an execution grant",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "channels"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "description": {
                "type": "string",
                "maxLength": 8000
              },
              "equipment": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "transport": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "procedure": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "channels": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "channel_id",
                    "quantity",
                    "unit"
                  ],
                  "properties": {
                    "channel_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "quantity": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "unit": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "calibration_id": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1000
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "source": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1000
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "scaling": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "gain",
                            "offset"
                          ],
                          "properties": {
                            "gain": {
                              "type": "number"
                            },
                            "offset": {
                              "type": "number"
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "limits": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "min",
                            "max"
                          ],
                          "properties": {
                            "min": {
                              "type": "number"
                            },
                            "max": {
                              "type": "number"
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "max_age_s": {
                      "anyOf": [
                        {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 3600
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "reference": {
                      "anyOf": [
                        {
                          "enum": [
                            "gauge",
                            "absolute",
                            "differential",
                            "unknown"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              },
              "source_refs": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "unknowns": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "replay_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          },
          "asset_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          }
        },
        "required": [
          "facts"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "read_bench_description",
      "description": "Read an accessible bench description and recorded revision.",
      "method": "GET",
      "path": [
        "bench-specs",
        ":spec_id"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "spec_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "spec_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "assess_bench_description",
      "description": "Explain deterministic support gaps without qualification authority.",
      "method": "POST",
      "path": [
        "bench-specs",
        ":spec_id",
        "assess"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "spec_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "spec_id"
        ],
        "additionalProperties": false
      }
    }
  ]
}
