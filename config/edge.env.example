# Copy to /etc/certarig/edge.env on the Pi (deploy/install_pi.sh does this and generates keys).
# Never commit real keys. Never paste them into chat.
CERTARIG_OPERATOR_KEY=replace-with-a-long-random-operator-key
CERTARIG_AGENT_KEY=replace-with-a-different-long-random-agent-key
# 0 keeps GPIO23 low whatever the kernel decides; set to 1 after the bench has been inspected.
CERTARIG_ENABLE_ACTUATION=0
# Command run by POST /v1/ops/shutdown after the kernel is safe and evidence is flushed.
# Leave unset on development machines; the node then only closes the runtime.
# CERTARIG_POWEROFF_CMD=sudo -n systemctl poweroff
# Optional model providers for the agent (engineering computer, not the Pi):
# ANTHROPIC_API_KEY=...        CERTARIG_ANTHROPIC_MODEL=claude-sonnet-4-5
# OPENAI_API_KEY=...           CERTARIG_OPENAI_MODEL=gpt-4.1-mini   OPENAI_BASE_URL=http://localhost:11434/v1
