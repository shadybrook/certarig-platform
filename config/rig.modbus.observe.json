      "warning_max": 75.0,
      "calibration_id": "REPLACE_WITH_REVIEWED_CALIBRATION",
      "required": true,
      "stuck_samples": 50,
      "stuck_epsilon": 0.01,
      "source": {
        "kind": "modbus_tcp",
        "register": 0,
        "function": 4,
        "device_id": 1,
        "data_type": "uint16",
        "gain": 0.1,
        "offset": 0,
